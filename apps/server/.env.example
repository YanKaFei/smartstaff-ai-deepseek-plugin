# Server
# 32-byte hex or base64 key; REQUIRED in production for webhook-secret encryption
SECRET_ENCRYPTION_KEY=
# db = shared buckets in the database (default); memory is single-process/dev only
RATE_LIMIT_BACKEND=db
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
DATABASE_PATH=
ADMIN_PASSWORD=
# Production requires an explicit allow-list. Do not use *.
CORS_ORIGINS=https://staff.example.com
REQUIRE_HTTPS=true
TRUST_PROXY=false
ACCESS_TOKEN_TTL_MINUTES=120
REFRESH_TOKEN_TTL_DAYS=30
SENSITIVE_REAUTH_MINUTES=15
# Demo login is dev-only and loopback-only. Leave false in production.
ALLOW_DEMO_LOGIN=false
DEMO_LOGIN_HOSTS=127.0.0.1,localhost,::1

# WeChat mini program (required for real wx.login)
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_TIMEOUT_MS=5000
WECHAT_OFFER_TEMPLATE_ID=

# SMS provider (phone verification). Missing config blocks the feature; it is never faked.
SMS_PROVIDER=
SMS_API_KEY=

# DeepSeek (server-side only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=20000
# Prices are configurable estimates; reconcile with the provider invoice.
DEEPSEEK_INPUT_PRICE_PER_MTOK=0.27
DEEPSEEK_OUTPUT_PRICE_PER_MTOK=1.1
DEEPSEEK_DAILY_BUDGET_USD=5
DEEPSEEK_MONTHLY_BUDGET_USD=80
DEEPSEEK_CACHE_TTL_MINUTES=30
# Update this when the configured prices are verified against the provider invoice.
DEEPSEEK_PRICE_UPDATED_AT=

# Optional transactional email (Resend). Without these, verification/invite/reset mail is queued but not sent.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_APP_URL=http://127.0.0.1:8787
